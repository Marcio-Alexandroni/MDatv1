{
  "info": {
    "name": "MDatv1 — Play Your List",
    "description": "Execute na ordem para criar recursos próprios, percorrer os endpoints e limpar os registros ao final. Inicie a aplicação antes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "musicaId",
      "value": ""
    },
    {
      "key": "playlistId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Listar músicas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/musicas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar música inicial",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/musicas/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar música",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/musicas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Hotel California\",\n  \"artista\": \"Eagles\",\n  \"album\": \"Hotel California\",\n  \"duracao\": 391,\n  \"genero\": \"Rock\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"musicaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Atualizar música",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/musicas/{{musicaId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Hotel California - estudo\",\n  \"artista\": \"Eagles\",\n  \"album\": \"Hotel California\",\n  \"duracao\": 391,\n  \"genero\": \"Rock\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
